generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id               String            @id @default(uuid())
  userId           String            @unique @map("user_id")
  email            String
  fullName         String?           @map("full_name")
  avatarUrl        String?           @map("avatar_url")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  focusSessions     FocusSession[]
  feedback          Feedback[]
  contentItems      ContentItem[]
  youtubeConnection YouTubeConnection?
  executiveConversations ExecutiveConversation[]
  financialSnapshots     FinancialSnapshot[]
  calendarConnection     CalendarConnection?
  gmailConnection        GmailConnection?
  driveConnection        DriveConnection?
  assignedTasks     Task[]            @relation("TaskAssignee")
  workspaceMembers  WorkspaceMember[]

  @@map("profiles")
}

model Workspace {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  projects    Project[]
  members     WorkspaceMember[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  role        Role      @default(MEMBER)
  workspaceId String    @map("workspace_id")
  profileId   String    @map("profile_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, profileId])
  @@map("workspace_members")
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  workspaceId String        @map("workspace_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks        Task[]
  contentItems ContentItem[]

  @@map("projects")
}

model Task {
  id            String         @id @default(uuid())
  title         String
  description   String?
  status        TaskStatus     @default(TODO)
  priority      Priority       @default(MEDIUM)
  projectId     String         @map("project_id")
  assigneeId    String?        @map("assignee_id")
  dueDate       DateTime?      @map("due_date")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  focusSessions FocusSession[]
  steps         TaskStep[]
  contentItems  ContentItem[]
  assignee      Profile?       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model TaskStep {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  title     String
  completed Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
  @@map("task_steps")
}

model FocusSession {
  id              String             @id @default(uuid())
  taskId          String             @map("task_id")
  profileId       String             @map("profile_id")
  status          FocusSessionStatus @default(ACTIVE)
  startedAt       DateTime           @default(now()) @map("started_at")
  endedAt         DateTime?          @map("ended_at")
  /// Set while the session is ACTIVE; null while PAUSED or finished.
  lastResumedAt   DateTime?          @map("last_resumed_at")
  /// Focus time banked before the current running interval.
  elapsedSeconds  Int                @default(0) @map("elapsed_seconds")
  /// Final rounded duration, written once the session ends.
  durationMinutes Int?               @map("duration_minutes")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  profile         Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  task            Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
  @@index([taskId, status])
  @@map("focus_sessions")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

enum FocusSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Feedback {
  id          String         @id @default(uuid())
  profileId   String         @map("profile_id")
  type        FeedbackType
  description String
  /// Route the tester was on when they submitted.
  page        String
  /// Captured automatically when the current route exposes one.
  taskId      String?        @map("task_id")
  status      FeedbackStatus @default(NEW)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@map("feedback")
}

enum FeedbackType {
  BUG
  CONFUSING
  MISSING_FEATURE
  IMPROVEMENT
}

enum FeedbackStatus {
  NEW
  REVIEWING
  FIXED
  DISMISSED
}

model ContentItem {
  id        String  @id @default(uuid())
  profileId String  @map("profile_id")
  projectId String? @map("project_id")
  taskId    String? @map("task_id")

  title       String
  description String        @default("")
  /// Comma-free list of YouTube tags.
  tags        String[]      @default([])
  /// YouTube category id, e.g. "22" (People & Blogs).
  categoryId  String        @default("22") @map("category_id")
  madeForKids Boolean       @default(false) @map("made_for_kids")
  contentType ContentType   @default(LONG_FORM) @map("content_type")
  status      ContentStatus @default(DRAFT)

  /// Absolute publish instant, stored in UTC.
  scheduledAt DateTime? @map("scheduled_at")
  /// IANA zone the user picked the time in, kept for display.
  timezone    String    @default("UTC")

  youtubeVideoId   String? @map("youtube_video_id")
  youtubeUrl       String? @map("youtube_url")
  /// 0-100, updated as the browser uploads.
  uploadProgress   Int     @default(0) @map("upload_progress")
  processingStatus String? @map("processing_status")

  publishedAt  DateTime? @map("published_at")
  errorMessage String?   @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([profileId, createdAt])
  @@index([taskId])
  @@map("content_items")
}

enum ContentType {
  LONG_FORM
  SHORT
}

enum ContentStatus {
  DRAFT
  READY
  UPLOADING
  PROCESSING
  /// On YouTube and finished processing, private, with no publish time set.
  UPLOADED
  SCHEDULED
  PUBLISHED
  FAILED
}

model ExecutiveConversation {
  id        String    @id @default(uuid())
  profileId String    @map("profile_id")
  executive Executive @default(HARPER)

  /// Null when the advice was generated without a question.
  userMessage String? @map("user_message")
  /// Harper's reply, stored as JSON so structured advice survives a reload.
  response    Json
  /// Exactly what was sent to the model, for auditability.
  contextSnapshot Json @map("context_snapshot")

  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, executive, createdAt])
  @@map("executive_conversations")
}

/**
 * A manually entered monthly financial position.
 *
 * Money is stored as integer cents to avoid float drift. There is no bank or
 * payment-processor connection — every figure here is typed by the user.
 */
model FinancialSnapshot {
  id        String   @id @default(uuid())
  profileId String   @map("profile_id")
  /// First day of the month this snapshot describes.
  periodStart DateTime @map("period_start")
  /// ISO 4217 code, e.g. "USD".
  currency  String   @default("USD")

  revenueCents           Int  @default(0) @map("revenue_cents")
  operatingExpensesCents Int  @default(0) @map("operating_expenses_cents")
  marketingSpendCents    Int  @default(0) @map("marketing_spend_cents")
  availableCashCents     Int  @default(0) @map("available_cash_cents")
  targetRevenueCents     Int? @map("target_revenue_cents")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, periodStart])
  @@index([profileId, periodStart])
  @@map("financial_snapshots")
}

enum Executive {
  HARPER
  RENEE
  SOPHIA
  OLIVIA
  MARCUS
}

/**
 * Google Calendar authorization, stored separately from YouTubeConnection.
 *
 * Separate rows and separate refresh tokens mean re-consenting to one can
 * never corrupt the other's stored token, and KurvzOS can use either
 * independently.
 *
 * Note the limit of that independence: both are granted through the same
 * Google Cloud project with include_granted_scopes=true, so Google holds them
 * as ONE combined authorization. Revoking at Google drops both. That is why
 * neither disconnect route revokes — see /api/calendar/disconnect.
 */
model CalendarConnection {
  id        String @id @default(uuid())
  profileId String @unique @map("profile_id")

  /// Display label only, e.g. the primary calendar's summary.
  calendarLabel String  @map("calendar_label")
  /// IANA zone reported by Google for the calendar.
  calendarTimeZone String @default("UTC") @map("calendar_time_zone")
  /// AES-256-GCM ciphertext. Never returned to the browser.
  encryptedRefreshToken String    @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  /// Space-separated scopes Google reported granting.
  grantedScopes String @default("") @map("granted_scopes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("calendar_connections")
}

/// Read-only Gmail access. Same shape as CalendarConnection deliberately:
/// one Google Cloud client, one encryption helper, one refresh-token pattern.
/// No message content is ever stored — only the credential and the identity of
/// the mailbox it belongs to.
model GmailConnection {
  id        String @id @default(uuid())
  profileId String @unique @map("profile_id")

  /// The connected mailbox address, for display on the connection card.
  emailAddress String @map("email_address")
  /// AES-256-GCM ciphertext. Never returned to the browser.
  encryptedRefreshToken String    @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  /// Space-separated scopes Google reported granting.
  grantedScopes String @default("") @map("granted_scopes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("gmail_connections")
}

/// Read-only Google Drive access. Same shape as the Gmail and Calendar
/// connections deliberately: one Google Cloud client, one encryption helper,
/// one refresh-token pattern.
///
/// No file content and no file metadata is ever stored here — only the
/// credential and the identity of the account it belongs to. File listings are
/// read live from Google and held in an in-process cache, never persisted.
model DriveConnection {
  id        String @id @default(uuid())
  profileId String @unique @map("profile_id")

  /// The connected Google account address, for display on the connection card.
  accountEmail String @map("account_email")
  /// AES-256-GCM ciphertext. Never returned to the browser.
  encryptedRefreshToken String    @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  /// Space-separated scopes Google reported granting.
  grantedScopes String @default("") @map("granted_scopes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("drive_connections")
}

model YouTubeConnection {
  id        String @id @default(uuid())
  profileId String @unique @map("profile_id")

  channelId    String @map("channel_id")
  channelTitle String @map("channel_title")
  /// AES-256-GCM ciphertext. Never returned to the browser.
  encryptedRefreshToken String    @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime? @map("token_expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("youtube_connections")
}
