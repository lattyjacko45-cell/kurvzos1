# Prisma runtime connection (use the pooled Supabase connection string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Prisma migrations (use Supabase's direct/session connection string).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Auth public browser configuration.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Public origin for OAuth callbacks. Do not include a trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth credentials shared by Calendar and YouTube.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# 32 random bytes encoded as base64. Keep server-side only.
YOUTUBE_TOKEN_ENCRYPTION_KEY="YOUR_32_BYTE_BASE64_KEY"

# Executive AI provider. Configure one provider key.
AI_PROVIDER="openai"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
# ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"
